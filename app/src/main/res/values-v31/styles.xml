<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.vivimusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#1F1F1F</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Ctrl Music splash: CM mark on charcoal -->
        <item name="android:windowSplashScreenBackground">#1F1F1F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1F1F1F</item>
    </style>

    <!-- Widget Theme for Android 12+ with Dynamic Colors -->
    <style name="Theme.Widget.vivimusic" parent="@android:style/Theme.DeviceDefault.DayNight" />
</resources>
